<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>

<GridPane xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="io.github.othmanechaoui.tictactoe.view.GameView"
          fx:id="root"
          alignment="CENTER"
          hgap="10.0"
          vgap="10.0">

    <children>

        <!-- Turn / winner label: (col 0, row 0) colspan 2 -->
        <Label fx:id="statusLabel"
               text="Player X"
               styleClass="display"
               GridPane.columnIndex="0" GridPane.rowIndex="0"
               GridPane.columnSpan="2"  GridPane.rowSpan="1"/>

        <!-- 3x3 board: columns 0..2, rows 2..4 -->
        <Button fx:id="cell00" text="" minWidth="100.0" minHeight="100.0"
                GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Button fx:id="cell01" text="" minWidth="100.0" minHeight="100.0"
                GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Button fx:id="cell02" text="" minWidth="100.0" minHeight="100.0"
                GridPane.columnIndex="2" GridPane.rowIndex="2"/>

        <Button fx:id="cell10" text="" minWidth="100.0" minHeight="100.0"
                GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Button fx:id="cell11" text="" minWidth="100.0" minHeight="100.0"
                GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Button fx:id="cell12" text="" minWidth="100.0" minHeight="100.0"
                GridPane.columnIndex="2" GridPane.rowIndex="3"/>

        <Button fx:id="cell20" text="" minWidth="100.0" minHeight="100.0"
                GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <Button fx:id="cell21" text="" minWidth="100.0" minHeight="100.0"
                GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <Button fx:id="cell22" text="" minWidth="100.0" minHeight="100.0"
                GridPane.columnIndex="2" GridPane.rowIndex="4"/>

        <!-- Restart button: (col 2, row 0) colspan 3 -->
        <Button fx:id="restartButton"
                text="RESTART"
                styleClass="restartBtn"
                GridPane.columnIndex="2" GridPane.rowIndex="0"
                GridPane.columnSpan="3"  GridPane.rowSpan="1"/>

    </children>
</GridPane>